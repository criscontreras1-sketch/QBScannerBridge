<Window x:Class="QBScannerBridge.ProductionBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production Board" Height="560" Width="1160"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- Column header style -->
        <Style x:Key="ColHeader" TargetType="Border">
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Column container -->
        <Style x:Key="ColPanel" TargetType="Border">
            <Setter Property="Background" Value="#F4F5F7"/>
            <Setter Property="BorderBrush" Value="#DDE0E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <DataTemplate x:Key="DocCard">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" FontSize="12"/>
                    <TextBlock Text="{Binding VendorName}" FontSize="11" Foreground="#444"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11" Foreground="#777">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:C}">
                                <Binding Path="TotalAmount" TargetNullValue=""/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#888"
                               TextTrimming="CharacterEllipsis" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#E4E7EB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="14,10">
            <TextBlock Text="Production Board" Foreground="White"
                       FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Kanban columns -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="10">
            <StackPanel Orientation="Horizontal">

                <!-- Incoming -->
                <Border Style="{StaticResource ColPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ColHeader}" Background="#3498DB">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Incoming" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Border Background="#1A6DA0" CornerRadius="8" Margin="6,0,0,0" Padding="5,1">
                                    <TextBlock Name="CountIncoming" Text="{Binding Incoming.Count}"
                                               Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Incoming}"
                                          ItemTemplate="{StaticResource DocCard}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Processing -->
                <Border Style="{StaticResource ColPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ColHeader}" Background="#E67E22">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Processing" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Border Background="#BF6010" CornerRadius="8" Margin="6,0,0,0" Padding="5,1">
                                    <TextBlock Text="{Binding Processing.Count}"
                                               Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Processing}"
                                          ItemTemplate="{StaticResource DocCard}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Review -->
                <Border Style="{StaticResource ColPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ColHeader}" Background="#8E44AD">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Review" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Border Background="#6C3483" CornerRadius="8" Margin="6,0,0,0" Padding="5,1">
                                    <TextBlock Text="{Binding Review.Count}"
                                               Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Review}"
                                          ItemTemplate="{StaticResource DocCard}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Posting -->
                <Border Style="{StaticResource ColPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ColHeader}" Background="#16A085">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Posting" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Border Background="#0E6655" CornerRadius="8" Margin="6,0,0,0" Padding="5,1">
                                    <TextBlock Text="{Binding Posting.Count}"
                                               Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Posting}"
                                          ItemTemplate="{StaticResource DocCard}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Done -->
                <Border Style="{StaticResource ColPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ColHeader}" Background="#27AE60">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Done" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Border Background="#1E8449" CornerRadius="8" Margin="6,0,0,0" Padding="5,1">
                                    <TextBlock Text="{Binding Done.Count}"
                                               Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Done}"
                                          ItemTemplate="{StaticResource DocCard}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Failed -->
                <Border Style="{StaticResource ColPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ColHeader}" Background="#C0392B">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Failed" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <Border Background="#922B21" CornerRadius="8" Margin="6,0,0,0" Padding="5,1">
                                    <TextBlock Text="{Binding Failed.Count}"
                                               Foreground="White" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Failed}"
                                          ItemTemplate="{StaticResource DocCard}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
